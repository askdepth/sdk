{
  "name": "@askdepth/contracts",
  "version": "0.2.1",
  "description": "Wire contracts for the Askdepth RUM SDK — base events, anomaly payloads, W3C Trace Context.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/askdepth/sdk.git",
    "directory": "packages/contracts"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./protocol-version": {
      "types": "./dist/versioning/protocol-version.d.ts",
      "import": "./dist/versioning/protocol-version.js",
      "require": "./dist/versioning/protocol-version.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.9.3",
    "vitest": "^3.0.5"
  }
}
