{
  "name": "@askdepth/core",
  "version": "0.0.1",
  "description": "Askdepth browser RUM core — init, consent, anomaly engines, W3C tracing, batching.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "size": "size-limit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@askdepth/contracts": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@vitest/coverage-v8": "^3.0.5",
    "@size-limit/preset-small-lib": "^11.2.0",
    "@types/node": "^22.10.2",
    "jsdom": "^26.0.0",
    "size-limit": "^11.2.0",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3",
    "vitest": "^3.0.5"
  },
  "size-limit": [
    {
      "path": "dist/index.mjs",
      "limit": "10 kB",
      "gzip": true
    }
  ]
}
