{
  "name": "@askdepth/sdk",
  "version": "0.0.0",
  "private": true,
  "description": "Askdepth TypeScript monorepo — independent client SDK packages (contracts, core, replay, react).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/askdepth/sdk.git"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "size": "turbo run size",
    "size-limit": "size-limit",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish",
    "example:vite": "pnpm --filter @askdepth/core exec vite --config ../../examples/react-vite/vite.config.ts",
    "example:vite:build": "pnpm --filter @askdepth/core exec vite build --config ../../examples/react-vite/vite.config.ts",
    "example:vite:preview": "pnpm --filter @askdepth/core exec vite preview --config ../../examples/react-vite/vite.config.ts",
    "example:vite:start": "pnpm --filter @askdepth/core exec vite preview --config ../../examples/react-vite/vite.config.ts",
    "example:vite:verify": "./node_modules/.pnpm/node_modules/.bin/vite-node --config examples/react-vite/vite.config.ts examples/react-vite/verify.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.28.1",
    "@size-limit/preset-small-lib": "^11.2.0",
    "size-limit": "^11.2.0",
    "turbo": "^2.5.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
